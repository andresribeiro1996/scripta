{
  "name": "@scripta/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./library/*": {
      "types": "./dist/library/*.d.ts",
      "default": "./dist/library/*.js"
    },
    "./murals/*": {
      "types": "./dist/murals/*.d.ts",
      "default": "./dist/murals/*.js"
    },
    "./tierlists/*": {
      "types": "./dist/tierlists/*.d.ts",
      "default": "./dist/tierlists/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
