{
  "name": "@scripta/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./library/*": {
      "types": "./dist/library/*.d.ts",
      "default": "./dist/library/*.js"
    },
    "./murals/*": {
      "types": "./dist/murals/*.d.ts",
      "default": "./dist/murals/*.js"
    },
    "./tierlists/*": {
      "types": "./dist/tierlists/*.d.ts",
      "default": "./dist/tierlists/*.js"
    },
    "./quizzes/*": {
      "types": "./dist/quizzes/*.d.ts",
      "default": "./dist/quizzes/*.js"
    },
    "./community": {
      "types": "./dist/community/index.d.ts",
      "default": "./dist/community/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "default": "./dist/dashboard.js"
    },
    "./readerCards": {
      "types": "./dist/readerCards/index.d.ts",
      "default": "./dist/readerCards/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "default": "./dist/themes/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sheet": "node --import tsx scripts/contact-sheet.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
