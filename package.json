{
  "name": "scripta",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "mobile",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "backend": "npm run dev --workspace backend",
    "frontend": "npm run dev --workspace frontend",
    "mobile": "npm run start --workspace mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "allowScripts": {
    "argon2@0.40.3": true,
    "esbuild@0.28.2": true
  }
}
