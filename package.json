{
  "name": "scripta",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "mobile",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "backend": "npm run dev:claim && npm run dev --workspace backend",
    "backend:fixture": "npm run dev:fixture --workspace backend",
    "frontend": "npm run dev:claim && npm run dev --workspace frontend",
    "mobile": "npm run start --workspace mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:claim": "node scripts/dev-claim.mjs",
    "dev:release": "node scripts/dev-release.mjs",
    "dev:status": "node scripts/dev-status.mjs",
    "dev:tunnels": "node scripts/dev-tunnels.mjs",
    "dev:wait": "node scripts/dev-wait.mjs",
    "dev:link-deps": "node scripts/dev-worktree-deps.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test": "npm run test:scripts && npm test --workspaces --if-present",
    "check:agents": "node scripts/sync-agent-table.mjs --check",
    "postinstall": "patch-package"
  },
  "allowScripts": {
    "argon2@0.40.3": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
