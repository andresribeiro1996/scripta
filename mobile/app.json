{
  "expo": {
    "name": "Scripta",
    "slug": "scripta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scripta",
    "extra": {
      "eas": {
        "projectId": "08320592-07d4-4e5b-b124-f46315c420df"
      }
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.atmyshelf.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "atmyshelf.com",
              "pathPrefix": "/shared/library/"
            },
            {
              "scheme": "https",
              "host": "atmyshelf.com",
              "pathPrefix": "/shared/murals/"
            },
            {
              "scheme": "https",
              "host": "atmyshelf.com",
              "pathPrefix": "/arena"
            },
            {
              "scheme": "https",
              "host": "atmyshelf.com",
              "pathPrefix": "/vote/"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
