# backend/.gitignore and frontend/.gitignore already handle node_modules/,
# dist/, .env, and backend's runtime data/ (SQLite files + uploaded/cached
# blobs) within those two directories. This file only covers what's
# outside them.

# Python (exporter/)
__pycache__/
*.pyc

# OS cruft
.DS_Store
Thumbs.db

# Claude Code: machine-local state (launch.json's absolute paths, linked
# worktrees, lockfiles) stays out; shared agent config is versioned so it
# travels with the repo the way AGENTS.md does. Matched at any depth, since
# packages carry their own .claude/ too.
**/.claude/*
!**/.claude/settings.json
!**/.claude/skills/
!**/.claude/commands/

# The exporter's own output against a real device — an actual person's
# reading history and highlights/annotations, not source code or a
# fixture. Deliberately not committed by default; drop it back in
# (git add -f exporter/library.json) if you want a sample library.json
# checked in.
exporter/library.json

# scripts/gen-mobile-certs.mjs's own output — a TLS cert/key for this
# machine's current LAN address, used only to test the PWA install/
# offline flow on a phone (see root README's "Testing on a phone").
# Machine-specific and regenerable; never meant to be shared or committed.
.certs/
.superpowers/

# OpenCode: its node_modules and lockfiles are machine state, but the skills
# are shared agent config and travel with the repo (same stance as .claude/
# above). .opencode/.gitignore already excludes the machine-local parts.
.opencode/*
!.opencode/skills/

# Dev-only scratch config for parallel sessions — see its own header.
frontend/vite.http.config.ts

# Personal remote-workflow notes — machine-specific, not project source.
todo/

# A real KoboReader.sqlite dropped at the root for local testing — same
# privacy stance as exporter/library.json above: a person's actual reading
# history and highlights, never source code.
/KoboReader.sqlite
/KoboReader.sqlite-shm
/KoboReader.sqlite-wal

# Workspace-wide (npm workspaces at the root since Task 2).
node_modules/
packages/*/dist/
