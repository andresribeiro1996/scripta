# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# "development" (default) | "production" | "test". Set to production on a
# real deployment: it stops auth's browser test console (/auth/console)
# from being registered at all.
NODE_ENV=development

# Whether to believe X-Forwarded-For. Every managed host (Fly, Render,
# Railway, anything behind a load balancer or CDN) puts a proxy in front
# of this app, and WITHOUT this every request looks like it came from the
# proxy — so all four per-module rate limiters collapse into one shared
# bucket and the login brute-force protection stops protecting anything.
#
# Leave "false" for local dev and any direct-to-internet setup: trusting
# the header with no proxy in front lets any client spoof its own IP and
# pick its own rate-limit bucket. Set "true" behind a trusted proxy, or
# list the proxy's IPs/CIDRs (comma-separated) to be stricter. A bare hop
# count is rejected — see src/config/env.ts for why.
TRUST_PROXY=false

# The frontend's origin, for CORS. Vite's dev server default.
FRONTEND_URL=http://localhost:5173

# --- library storage ---------------------------------------------------
#
# Set DATABASE_URL and every module that HAS a Postgres adapter uses it
# instead of its SQLite file; leave it blank and nothing changes.
#
# Have one: `library`, `auth`.
# Still SQLite-only: `gallery` metadata, `covers` cache, `socials`.
#
# So a deployment with this set STILL needs the volume for those three, and
# still cannot run more than one instance.
#
# Why you'd want it: a SQLite file on a volume can only attach to ONE
# machine, so a SQLite deployment cannot have replicas, rolling deploys, or
# point-in-time restore. It is not about speed.
#
# Migrating an existing deployment (run with the app stopped):
#   node --import tsx scripts/sqlite-to-postgres.mjs \
#     --sqlite ./data/library.sqlite --auth-sqlite ./data/auth.sqlite \
#     --postgres "$DATABASE_URL" --dry-run
DATABASE_URL=
# "on" (default, verify the certificate) | "no-verify" (encrypted but
# unverified — some managed providers present a chain the container has no
# root for) | "off" (no TLS; local development only).
DATABASE_SSL=on
DATABASE_POOL_MAX=10

# --- blob storage -----------------------------------------------------
#
# Gallery uploads and the resolved-cover cache. Set S3_BUCKET and both move
# to object storage; leave it blank and they stay on local disk.
#
# This is the OTHER thing pinning the API to one machine — Postgres alone
# does NOT free it, because blobs on local disk mean the container can only
# run in one place. Set both and the API is finally stateless.
#
# Written against the S3 API, so Cloudflare R2, Backblaze B2, MinIO or AWS
# S3 all work. R2 is the recommendation: zero egress fees, which matters
# because cover images are served on every page view.
#
# Migrating existing local files (run with the app stopped):
#   node --import tsx scripts/files-to-object-storage.mjs --dry-run
#
# The script never deletes local files. Verify the app serves images from
# the bucket before removing them — gallery uploads are user-supplied and
# exist nowhere else.
S3_BUCKET=
# R2/MinIO need this; real AWS S3 infers it from the region, so leave blank.
#   R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# R2 ignores the region but the SDK requires one. "auto" is what
# Cloudflare's own docs use; AWS needs the bucket's real region.
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket in the path rather than the hostname. Required by R2 and MinIO.
S3_FORCE_PATH_STYLE=true

# Each module owns its own SQLite file — see each module's directory.
# LIBRARY_DB_PATH is ignored when DATABASE_URL is set, but still required,
# so switching to Postgres and back doesn't need config archaeology.
AUTH_DB_PATH=./data/auth.sqlite
LIBRARY_DB_PATH=./data/library.sqlite
GALLERY_DB_PATH=./data/gallery.sqlite

# Uploaded gallery images, one subdirectory per account. Ignored when
# S3_BUCKET is set.
GALLERY_STORAGE_PATH=./data/gallery-files

# The auto-resolved cover cache — global, shared across every account (see
# modules/covers). Both have code-level defaults matching these values, so
# this section can be left out entirely; listed for visibility.
COVERS_DB_PATH=./data/covers.sqlite
COVERS_STORAGE_PATH=./data/covers-files
SOCIALS_DB_PATH=./data/socials.sqlite

# This API's own externally-reachable base URL — used to build absolute
# image URLs. Change this to the real deployed origin in production.
PUBLIC_API_URL=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-me-with-a-different-random-64-char-hex-string

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# From https://console.cloud.google.com/apis/credentials — create an OAuth
# 2.0 Client ID (Web application), with GOOGLE_CALLBACK_URL added as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Where to send the browser after a successful Google login, with the
# issued tokens appended as a URL fragment (#access_token=...&refresh_token=...).
# Points at the frontend's own callback route.
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/oauth-success

# Optional — enables Hardcover as an extra cover-art fallback source (see
# modules/covers). Get one from https://hardcover.app: sign in, go to
# Settings, and generate an API key from there. Leave blank to skip this
# integration entirely — the app runs fine without it, falling back to
# Open Library/Google Books the same as before.
HARDCOVER_API_KEY=

# modules/socials — the "Socials" section of Settings, connecting X/
# Instagram/Threads/TikTok/Bluesky so this app can act on the user's
# behalf later. Each of the four platforms below is independently
# optional: leave a platform's three vars blank and its toggle in
# Settings just stays disabled with an explanation, same "quietly
# skipped" shape as Google/Hardcover above. Bluesky needs no per-app
# credentials at all — see SOCIALS_ENCRYPTION_KEY below instead.

# From https://developer.x.com — create a project + app, enable OAuth 2.0
# with "Read and write" permissions, add X_CALLBACK_URL as a callback URL.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:3000/socials/x/callback

# From https://developers.facebook.com — create an app with the
# "Instagram API with Instagram Login" product, add INSTAGRAM_CALLBACK_URL
# as a valid OAuth redirect URI. Requires an Instagram business/creator
# account. Endpoint/scope details in providerConfig.ts may need a small
# adjustment against Meta's current docs — see that file's own comment.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CALLBACK_URL=http://localhost:3000/socials/instagram/callback

# From https://developers.facebook.com — same developer app family as
# Instagram above, but the separate Threads API product.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_CALLBACK_URL=http://localhost:3000/socials/threads/callback

# From https://developers.tiktok.com — TikTok calls this a "client key",
# not "client id"; that's the value that goes here.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=http://localhost:3000/socials/tiktok/callback

# Where to send the browser back after a connect/disconnect round trip —
# lands on the Settings page itself, unlike OAUTH_SUCCESS_REDIRECT_URL
# above (no tokens ride this redirect; see modules/socials/plugin.ts).
SOCIALS_SUCCESS_REDIRECT_URL=http://localhost:5173/dashboard/settings

# Required for ANY social platform to connect, Bluesky included — the
# key every platform's access/refresh token is encrypted at rest with.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCIALS_ENCRYPTION_KEY=
