# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# The frontend's origin, for CORS. Vite's dev server default.
FRONTEND_URL=http://localhost:5173

# Also accept private-network origins (192.168.x.x, 10.x.x.x, loopback)
# for CORS, on any port — needed to open the app from a phone on the same
# Wi-Fi, whose Origin is a LAN address FRONTEND_URL above can't predict.
# `npm run dev:mobile` sets this for its own process, so there's normally
# no reason to put it here at all. Never enable it in production.
# ALLOW_LAN_ORIGINS=false

# Each module owns its own SQLite file — see each module's directory.
AUTH_DB_PATH=./data/auth.sqlite
LIBRARY_DB_PATH=./data/library.sqlite
GALLERY_DB_PATH=./data/gallery.sqlite

# Uploaded gallery images, one subdirectory per account.
GALLERY_STORAGE_PATH=./data/gallery-files

# Profile pictures (auth module avatars) — same shape as gallery storage.
# Has a code-level default matching this value, so it can be left out.
AVATAR_STORAGE_PATH=./data/avatar-files

MURALS_DB_PATH=./data/murals.sqlite

# The auto-resolved cover cache — global, shared across every account (see
# modules/covers). Both have code-level defaults matching these values, so
# this section can be left out entirely; listed for visibility.
COVERS_DB_PATH=./data/covers.sqlite
COVERS_STORAGE_PATH=./data/covers-files
SOCIALS_DB_PATH=./data/socials.sqlite
ARENA_DB_PATH=./data/arena.sqlite
TIERLISTS_DB_PATH=./data/tierlists.sqlite

# This API's own externally-reachable base URL — used to build absolute
# image URLs. Change this to the real deployed origin in production.
PUBLIC_API_URL=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-me-with-a-different-random-64-char-hex-string

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# From https://console.cloud.google.com/apis/credentials — create an OAuth
# 2.0 Client ID (Web application), with GOOGLE_CALLBACK_URL added as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Where to send the browser after a successful Google login, with a
# short-lived, single-use authorization code appended as a query param
# (?code=...) — never the tokens themselves (see the migration plan's
# global "never place access or refresh tokens in URLs" constraint).
# Points at the frontend's own callback route, which exchanges the code
# through POST /auth/google/exchange.
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/oauth-success

# Task 4A — comma-separated, EXACT redirect targets the mobile app may ask
# Google sign-in to land back on instead of OAUTH_SUCCESS_REDIRECT_URL
# above. A starting GET /auth/google request selects one of these by exact
# string match via its own redirect_target query param; anything not
# listed here is rejected outright, never trusted from the request. Until
# a deployed HTTPS origin/Universal Link exists (see the migration plan's
# Task 4C), a dev-only custom-scheme entry is enough —
# mobile/src/features/auth/googleSignIn.ts builds exactly this string via
# expo-linking's createURL("oauth-redirect") against mobile/app.json's own
# "scheme": "scripta". Blank disables the mobile flow (the plain
# desktop-web flow above never sets redirect_target, so it's unaffected).
MOBILE_OAUTH_REDIRECT_ALLOWLIST=scripta://oauth-redirect

# Optional — enables Hardcover as an extra cover-art fallback source (see
# modules/covers). Get one from https://hardcover.app: sign in, go to
# Settings, and generate an API key from there. Leave blank to skip this
# integration entirely — the app runs fine without it, falling back to
# Open Library/Google Books the same as before.
HARDCOVER_API_KEY=

# modules/socials — the "Socials" section of Settings, connecting X/
# Instagram/Threads/TikTok/Bluesky so this app can act on the user's
# behalf later. Each of the four platforms below is independently
# optional: leave a platform's three vars blank and its toggle in
# Settings just stays disabled with an explanation, same "quietly
# skipped" shape as Google/Hardcover above. Bluesky needs no per-app
# credentials at all — see SOCIALS_ENCRYPTION_KEY below instead.

# From https://developer.x.com — create a project + app, enable OAuth 2.0
# with "Read and write" permissions, add X_CALLBACK_URL as a callback URL.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:3000/socials/x/callback

# From https://developers.facebook.com — create an app with the
# "Instagram API with Instagram Login" product, add INSTAGRAM_CALLBACK_URL
# as a valid OAuth redirect URI. Requires an Instagram business/creator
# account. Endpoint/scope details in providerConfig.ts may need a small
# adjustment against Meta's current docs — see that file's own comment.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CALLBACK_URL=http://localhost:3000/socials/instagram/callback

# From https://developers.facebook.com — same developer app family as
# Instagram above, but the separate Threads API product.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_CALLBACK_URL=http://localhost:3000/socials/threads/callback

# From https://developers.tiktok.com — TikTok calls this a "client key",
# not "client id"; that's the value that goes here.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=http://localhost:3000/socials/tiktok/callback

# Where to send the browser back after a connect/disconnect round trip —
# lands on the Settings page itself, unlike OAUTH_SUCCESS_REDIRECT_URL
# above (no tokens ride this redirect; see modules/socials/plugin.ts).
SOCIALS_SUCCESS_REDIRECT_URL=http://localhost:5173/dashboard/settings

# Required for ANY social platform to connect, Bluesky included — the
# key every platform's access/refresh token is encrypted at rest with.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCIALS_ENCRYPTION_KEY=
