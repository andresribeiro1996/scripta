# Dummy configuration so the test suite can import src/config/env.ts,
# which validates the environment at module load. These values are never
# used to reach anything real — the tests drive in-memory databases and
# throwaway Fastify instances. Committed on purpose so `npm test` works on
# a fresh checkout and in CI with no setup.
NODE_ENV=test
AUTH_DB_PATH=:memory:
LIBRARY_DB_PATH=:memory:
GALLERY_DB_PATH=:memory:
GALLERY_STORAGE_PATH=./.test-tmp/gallery
COVERS_DB_PATH=:memory:
COVERS_STORAGE_PATH=./.test-tmp/covers
SOCIALS_DB_PATH=:memory:
JWT_ACCESS_SECRET=test-only-access-secret-not-used-for-anything-real-0000
JWT_REFRESH_SECRET=test-only-refresh-secret-not-used-for-anything-real-000
