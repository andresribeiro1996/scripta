{
  "name": "atmyshelf-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for AtMyShelf — auth, library, gallery, covers and social connections.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --env-file=test/.env.test --import tsx --test test/*.test.ts",
    "backup": "node --import tsx scripts/backup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/oauth2": "^8.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@types/pg": "^8.23.1",
    "argon2": "^0.40.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.15.0",
    "s3rver": "^3.7.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
