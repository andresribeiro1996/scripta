{
  "name": "kobo-library-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the Kobo Library Viewer — currently just the isolated auth module.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:mobile": "node scripts/dev-mobile.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/modules/arena/service.test.ts src/modules/auth/service.test.ts src/modules/murals/service.test.ts src/modules/tierlists/service.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/oauth2": "^8.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "argon2": "^0.40.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "jsonwebtoken": "^9.0.2",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "allowScripts": {
    "argon2@0.40.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
